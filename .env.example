PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# MySQL connection (create the database first; see README.md)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ledgerly

# Used by npm run seed-admin to create or promote your administrator account
ADMIN_NAME=Ledgerly Admin
ADMIN_EMAIL=admin@yourbusiness.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Optional payment configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret
# Optional comma-separated origins when frontend is hosted on a different domain
# CORS_ORIGIN=https://your-frontend.example.com
